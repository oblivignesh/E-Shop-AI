# ---- LLM ----
ANTHROPIC_API_KEY=your_anthropic_key_here

# Router / cheap classifier model
AURA_ROUTER_MODEL=claude-haiku-4-5
# Reasoning model for specialist agents
AURA_AGENT_MODEL=claude-sonnet-4-5

# ---- Observability (optional but recommended) ----
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=aura-eshop

# ---- Paths ----
AURA_DB_PATH=data/aura.db
AURA_CHECKPOINT_DB_PATH=data/checkpoints.db
AURA_CHROMA_DIR=data/chroma
AURA_POLICIES_DIR=policies
AURA_RAW_DATA_DIR=data/raw

# ---- Business rules ----
# Refunds strictly below this amount (INR) can be auto-approved. >= this needs HITL.
AURA_REFUND_AUTO_APPROVE_MAX=5000.0
AURA_CURRENCY_SYMBOL=₹
AURA_CURRENCY_CODE=INR
